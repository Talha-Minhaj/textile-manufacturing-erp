# ==============================================================================
# ThreadCraft ERP - Environment Configuration Template
# Enterprise Apparel Manufacturing & Operations Platform
# ==============================================================================
# Copy this file to .env and configure the secrets for your local or production setup:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Production / Docker PostgreSQL Connection String:
DATABASE_URL="postgresql://threadcraft:threadcraft_secure_pass@localhost:5432/threadcraft_erp?schema=public"

# For zero-dependency local SQLite development (uncomment below and adjust schema.prisma provider to "sqlite"):
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# 256-bit secret used to sign and verify JSON Web Tokens (jose HS256).
# Generate a strong production key via: openssl rand -base64 48
AUTH_SECRET="your-super-secret-jwt-signing-key-min-32-chars-change-in-production"

# Initial seeded administrator password (created on initial DB seed):
SEED_ADMIN_PASSWORD="AdminSecurePassword123!"

# Set to "1" ONLY when running over plain HTTP (localhost / internal container network)
# When set to "0" or omitted in production, session cookies enforce the Secure flag (HTTPS required).
COOKIE_INSECURE="1"

# ------------------------------------------------------------------------------
# 3. CORE ERP BUSINESS RULES & INTEGRITY GUARDS
# ------------------------------------------------------------------------------
# When "false", the ledger rejects any stock movement that causes an item balance
# in a warehouse to drop below zero (atomic decrement condition).
# When "true", negative balances are permitted (useful for reconciliation grace periods).
ALLOW_NEGATIVE_STOCK="false"

# Application Server Port
PORT=3000

# ------------------------------------------------------------------------------
# 4. FORWARD DEPLOYED AI ASSISTANT EXTENSION
# ------------------------------------------------------------------------------
# AI Provider: "heuristic" (default zero-dependency offline parser), "openai", or "gemini"
AI_PROVIDER="heuristic"

# Optional LLM API keys for generative query synthesis (leave blank for deterministic heuristic mode):
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_SERVICE_URL="http://localhost:8000"
